DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/warehouse_ledger
# Tests wipe their own DB (not warehouse_ledger). Create it and migrate once:
# CREATE DATABASE warehouse_ledger_test OWNER ledger;
# TEST_DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/warehouse_ledger_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
# Paystack → Settings → API Keys & Webhooks (test keys). Restart API after changing .env.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Must match the Vite dev URL (port may be 5173, 5174, …). Trailing slash is fine.
CHECKOUT_CALLBACK_URL=http://localhost:5173/
# Production (Rackzar): https://ledger.customchatandautomation.co.za/
# Leave empty on the server — UI and API share one host via Caddy.
CORS_ORIGINS=
